# kind v0.33.0 release node image, Kubernetes 1.37.0. Only adds the Python driver.
FROM kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
RUN apt-get update && apt-get install -y --no-install-recommends python3 sudo jq curl \
    && rm -rf /var/lib/apt/lists/*
